{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./data/**)",
      "Read(//tank/vault/**)",
      "Read(~/.local/share/mimir-advisor/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "./.env",
        "./data",
        "/tank/vault",
        "~/.local/share/mimir-advisor"
      ]
    }
  }
}
