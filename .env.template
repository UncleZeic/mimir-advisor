# .env.template  (copy to .env)
PROJECT_NAME=mimir-advisor
PERSONA=Adjutant_Mimir
MODEL_NAME=gemma4:12b
EMBED_MODEL=bge-m3
# Ollama runs on the host, not in Docker. Only localhost, 127.0.0.1 and ::1 are
# accepted (plus host.docker.internal inside a container); note text never goes
# to another host.
OLLAMA_BASE_URL=http://localhost:11434
# Synthetic notes by default. Point at real notes only from a terminal
# outside VS Code, per command:  DATA_SOURCE_DIR=/tank/vault/tech python3 src/main.py ...
DATA_SOURCE_DIR=./tests/fixtures/vault
# Indexes contain note text; default is ~/.local/share/mimir-advisor/index.
# Files go in a mimir-advisor-index/ subfolder; refused inside the repo or DATA_SOURCE_DIR.
# INDEX_DIR=
# At least 300 (must exceed the 150-char chunk overlap)
CHUNK_MAX_CHARS=1200
HEALTH_TIMEOUT_SECONDS=2
OLLAMA_CHAT_TIMEOUT_SECONDS=60
OLLAMA_EMBED_TIMEOUT_SECONDS=120
# Docker only: run the container as your host user. Required, no default:
# the index must be owned by you. Set them to the output of id -u / id -g.
# HOST_UID=
# HOST_GID=
