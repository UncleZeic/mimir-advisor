# .env.template  (copy to .env)
PROJECT_NAME=mimir-advisor
PERSONA=Adjutant_Mimir
MODEL_NAME=llama3
EMBED_MODEL=bge-m3
# Ollama runs on the host, not in Docker
OLLAMA_BASE_URL=http://localhost:11434
# Synthetic notes by default. Point at real notes only from a terminal
# outside VS Code, per command:  DATA_SOURCE_DIR=~/vault/tech python3 src/main.py ...
DATA_SOURCE_DIR=./tests/fixtures/vault
# Indexes contain note text; default is ~/.local/share/mimir-advisor/index
# INDEX_DIR=
CHUNK_MAX_CHARS=1200
HEALTH_TIMEOUT_SECONDS=2
OLLAMA_CHAT_TIMEOUT_SECONDS=60
OLLAMA_EMBED_TIMEOUT_SECONDS=120
